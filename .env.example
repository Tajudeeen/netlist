# Copy to .env and fill in before deploying. Never commit the real .env.

# Deployer private key (needs native gas token, OKB on X Layer, to pay for deployment)
PRIVATE_KEY=0xyour_private_key_here

# Override the default RPC URLs in hardhat.config.js if needed
XLAYER_TESTNET_RPC=
XLAYER_MAINNET_RPC=

# CompositionRegistry constructor args
ATTESTATION_FEE_WEI=0
GAS_PER_GATE=450
